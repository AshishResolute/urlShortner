generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id         Int         @id @default(autoincrement())
  email      String      @unique
  password   String
  user_name  String
  created_at DateTime    @default(now())
  urls       short_url[]
}

model short_url {
  id           Int      @id @default(autoincrement())
  original_url String
  short_code   String   @unique
  clicks       Int      @default(0)
  created_at   DateTime @default(now())
  user_id      Int
  user         users    @relation(fields: [user_id], references: [id])
}