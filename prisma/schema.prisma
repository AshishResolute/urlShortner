
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
 model User {
  id         Int @id   @default(autoincrement())
  email      String    @unique
  password   String
  username   String
  created_at DateTime @default(now())
  urls       ShortUrl[]
  @@map("users")
 }

 model ShortUrl {
  id         Int      @id @default(autoincrement())
  orginalUrl String
  shortCode  String
  clicks     Int          @default(0)
  created_at DateTime     @default(now())
  userId     Int
  user       User     @relation(fields:[userId],references:[id])
  @@map("short_url")
 }